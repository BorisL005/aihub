{
  "expo": {
    "name": "AI Hub",
    "slug": "aihub-mobile",
    "scheme": "aihub",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.aihub.mobile"
    },
    "android": {
      "package": "dev.aihub.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "AI Hub uses the camera to photograph your receipts."
        }
      ]
    ]
  }
}
