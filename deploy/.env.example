# Template for deploy/.env on the staging server (KAN-12). Copy this file to 
# deploy/.env on the VPS and fill in real values - deploy/.env itself is 
# never committed and the deploy workflow never syncs or overwrites it. 
# See backend/README.md for what each Auth0/R2 variable does. 

# --- Auth0 (backend/README.md) --- 
AUTH0_ISSUER_URI=https://your-tenant.auth0.example/ 
AUTH0_AUDIENCE=https://api.your-tenant.example/ 

# --- Cloudflare R2 (same account as capture media / eval sync) --- 
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com 
R2_BUCKET=aihub-media 
R2_ACCESS_KEY_ID=changeme 
R2_SECRET_ACCESS_KEY=changeme 

# --- Postgres --- 
# Consumed by both the db service (container entrypoint) and the app 
# service (Spring datasource) - both are given this same .env via env_file. 
POSTGRES_DB=aihub 
POSTGRES_USER=aihub 
POSTGRES_PASSWORD=changeme 
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/aihub 
SPRING_DATASOURCE_USERNAME=aihub 
SPRING_DATASOURCE_PASSWORD=changeme 
